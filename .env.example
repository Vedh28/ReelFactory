# Groq writes the script; ElevenLabs handles speech and video.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VIDEO_MODEL=veo-3.1-fast-generate-001

# Instagram professional account connected to a Meta app with publishing permission.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v25.0

GENRE=motivational facts
AUTO_PUBLISH=true
OUTPUT_DIR=output
